# ============================================================================
# Anagu Land Administration Framework — Environment Template (.env.example)
# Copy to .env (`cp .env.example .env`) and replace all CHANGE_ME placeholders
# before starting services. NEVER commit .env or real secrets to git.
# ============================================================================

# ============================================================================
# GROUP 1: REQUIRED IMMEDIATELY FOR PHASE 3 INFRASTRUCTURE (Docker Compose)
# ============================================================================
NODE_ENV=development
BIND_ADDRESS=127.0.0.1
ANAGU_APPLY_DEV_SEED=false

# PostgreSQL 15 + PostGIS 3
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=anagu
POSTGRES_USER=anagu_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# Redis 7
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# MinIO Private Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_ROOT_PASSWORD
MINIO_BUCKET_DOCUMENTS=land-documents
MINIO_BUCKET_SURVEYS=survey-plans
MINIO_BUCKET_CERTIFICATES=title-certificates
MINIO_BUCKET_IDENTITY=identity-documents

# EMQX MQTT Broker
MQTT_PORT=1883
MQTT_WS_PORT=8083
MQTT_WSS_PORT=8084
MQTT_TLS_PORT=8883
EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=CHANGE_ME_STRONG_EMQX_DASHBOARD_PASSWORD

# ============================================================================
# GROUP 2: REQUIRED LATER FOR PHASE 4 (NestJS Backend API & GIS/Oracle/Storage)
# ============================================================================
DATABASE_URL=postgresql://anagu_admin:CHANGE_ME_STRONG_POSTGRES_PASSWORD@localhost:5433/anagu
DATABASE_APP_USER=anagu_app_rw
DATABASE_APP_PASSWORD=CHANGE_ME_APP_ROLE_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@localhost:6379

MINIO_APP_USER=anagu_backend_storage
MINIO_APP_PASSWORD=CHANGE_ME_MINIO_APP_PASSWORD
MAX_DOCUMENT_SIZE_BYTES=26214400

MQTT_URL=mqtt://localhost:1883
MQTT_WS_URL=ws://localhost:8083/mqtt
MQTT_USERNAME=anagu_backend_service
MQTT_PASSWORD=CHANGE_ME_MQTT_SERVICE_PASSWORD

JWT_SECRET=CHANGE_ME_MIN_64_CHAR_RANDOM_JWT_SECRET
JWT_EXPIRES_IN=1d

GIS_COORDINATE_SRID=4326
GIS_OVERLAP_TOLERANCE_METRES=0.5
ORACLE_FUZZY_MATCH_THRESHOLD=0.82
ORACLE_MIN_COMMUNITY_WITNESSES=2

# ============================================================================
# GROUP 3: REQUIRED LATER FOR PHASE 5 & PHASE 6 (Blockchain, Frontend & Prod)
# (Not needed to start Phase 3 infrastructure)
# ============================================================================
CHAIN_ID=80002
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGONSCAN_API_KEY=CHANGE_ME_POLYGONSCAN_API_KEY
DEPLOYER_PRIVATE_KEY=CHANGE_ME_TESTNET_ONLY_PRIVATE_KEY_DO_NOT_USE_MAINNET_FUNDS
GOVERNOR_ADDRESS=CHANGE_ME_GOVERNOR_WALLET_ADDRESS
REGISTRAR_ADDRESS=CHANGE_ME_REGISTRAR_WALLET_ADDRESS
LAND_TITLE_NFT_ADDRESS=CHANGE_ME_DEPLOYED_LAND_TITLE_NFT_ADDRESS
LAND_REGISTRY_ADDRESS=CHANGE_ME_DEPLOYED_LAND_REGISTRY_ADDRESS
HARDHAT_DISABLE_NODE_VERSION_CHECK=true

VITE_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_MQTT_URL=ws://localhost:8083/mqtt

# Optional External Auth/Realtime Sync (Supabase)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=