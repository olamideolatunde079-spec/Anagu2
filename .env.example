# ============================================================================
# Anagu Land Administration Framework — Environment Template
# Copy to .env and populate every credential before starting services.
# NEVER commit .env or real passwords/private keys to version control.
# ============================================================================

# ── Runtime Mode & Host Binding ─────────────────────────────────────────────
NODE_ENV=development
BIND_ADDRESS=127.0.0.1
ANAGU_APPLY_DEV_SEED=false

# ── PostgreSQL 15 + PostGIS 3 ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=anagu
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# ── Redis 7 ─────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# ── MinIO Private Object Storage ────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_APP_USER=
MINIO_APP_PASSWORD=
MINIO_BUCKET_DOCUMENTS=land-documents
MINIO_BUCKET_SURVEYS=survey-plans
MINIO_BUCKET_CERTIFICATES=title-certificates
MINIO_BUCKET_IDENTITY=identity-documents
MAX_DOCUMENT_SIZE_BYTES=26214400

# ── EMQX MQTT Broker ────────────────────────────────────────────────────────
MQTT_URL=mqtt://localhost:1883
MQTT_WS_URL=ws://localhost:8083/mqtt
MQTT_PORT=1883
MQTT_WS_PORT=8083
MQTT_WSS_PORT=8084
MQTT_TLS_PORT=8883
EMQX_DASHBOARD_PORT=18083
MQTT_USERNAME=
MQTT_PASSWORD=
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=

# ── GIS & Verification Parameters ───────────────────────────────────────────
GIS_COORDINATE_SRID=4326
GIS_OVERLAP_TOLERANCE_METRES=0.5
ORACLE_FUZZY_MATCH_THRESHOLD=0.82
ORACLE_MIN_COMMUNITY_WITNESSES=2

# ── Blockchain (Polygon Amoy Testnet — Chain ID 80002) ──────────────────────
CHAIN_ID=80002
POLYGON_AMOY_RPC_URL=
POLYGONSCAN_API_KEY=
DEPLOYER_PRIVATE_KEY=
GOVERNOR_ADDRESS=
REGISTRAR_ADDRESS=
LAND_TITLE_NFT_ADDRESS=
LAND_REGISTRY_ADDRESS=
HARDHAT_DISABLE_NODE_VERSION_CHECK=true

# ── Backend Auth & Frontend ─────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=1d
VITE_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_MQTT_URL=ws://localhost:8083/mqtt

# ── Optional External Sync (Supabase) ───────────────────────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=