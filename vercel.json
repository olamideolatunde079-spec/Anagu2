{
  "buildCommand": "cd apps/anugu2 && npm install --legacy-peer-deps && npm run build",
  "outputDirectory": "apps/anugu2/dist",
  "installCommand": "echo skip-root-install",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
