{
  "name": "@anagu/contracts",
  "version": "1.0.0",
  "description": "Anagu smart contracts — LandTitleNFT (ERC-721) and LandRegistry",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test --network hardhat",
    "test:amoy": "hardhat test --network polygon_amoy",
    "test:besu": "hardhat test --network besu_local",
    "deploy:amoy": "hardhat run scripts/deploy.ts --network polygon_amoy",
    "deploy:local": "hardhat run scripts/deploy.ts --network besu_local",
    "deploy:hardhat": "hardhat run scripts/deploy.ts --network hardhat",
    "typechain": "hardhat typechain",
    "clean": "hardhat clean",
    "coverage": "hardhat coverage",
    "verify:amoy": "hardhat run scripts/verify.ts --network polygon_amoy",
    "verify:besu": "hardhat run scripts/verify.ts --network besu_local",
    "node": "hardhat node",
    "seed:amoy": "hardhat run scripts/seed.ts --network polygon_amoy",
    "seed:local": "hardhat run scripts/seed.ts --network besu_local",
    "verify:local": "hardhat run scripts/verify.ts --network besu_local"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@nomicfoundation/hardhat-chai-matchers": "2.0.6",
    "@nomicfoundation/hardhat-ethers": "3.0.5",
    "@nomicfoundation/hardhat-network-helpers": "1.0.10",
    "@typechain/ethers-v6": "0.5.1",
    "@typechain/hardhat": "9.1.0",
    "@types/chai": "4.3.14",
    "@types/mocha": "10.0.6",
    "@types/node": "20.12.7",
    "chai": "4.4.1",
    "ethers": "6.11.1",
    "hardhat": "2.22.17",
    "hardhat-gas-reporter": "1.0.10",
    "solidity-coverage": "0.8.12",
    "ts-node": "10.9.2",
    "typechain": "8.3.2",
    "typescript": "5.4.5",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@nomicfoundation/hardhat-ignition": "^0.15.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "4.9.6"
  },
  "ts-node": {
    "transpileOnly": true,
    "esm": false
  }
}
